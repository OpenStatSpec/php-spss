{
  "name": "tiamo/spss",
  "description": "SPSS is a php-based implementation of IBM SPSS Statistics Standard",
  "keywords": [
    "SPSS",
    "IBM",
    "PSPP",
    "Statistics",
    "DataSet",
    "por",
    "sav",
    "reader",
    "writer",
    "cli",
    "cli-app"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Korniienko Vladyslav",
      "email": "vk.tiamo@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4.1",
    "ext-bcmath": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.2",
    "rector/rector": "^2.5"
  },
  "autoload": {
    "psr-4": {
      "SPSS\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SPSS\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": false,
    "audit": {
      "abandoned": "fail"
    },
    "platform": {
      "php": "8.4.1"
    },
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "scripts": {
    "fix": [
      "rector process",
      "php-cs-fixer fix --verbose"
    ],
    "hooks:install": "git config core.hooksPath .githooks",
    "post-install-cmd": "@hooks:install",
    "post-update-cmd": "@hooks:install",
    "qa": [
      "@test:composer",
      "@test:syntax",
      "@test:style",
      "@test:rector",
      "@test:types",
      "@test:unit"
    ],
    "test:composer": [
      "@composer validate --strict",
      "@composer audit --locked"
    ],
    "test:rector": "rector process --dry-run",
    "test:style": "php-cs-fixer check --diff --verbose",
    "test:syntax": "parallel-lint --exclude vendor .php-cs-fixer.dist.php rector.php src tests examples",
    "test:types": "phpstan analyse --no-progress --memory-limit=1G",
    "test:unit": "phpunit --no-coverage",
    "test": "@qa"
  }
}
