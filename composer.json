{
  "name": "tiamo/spss",
  "description": "SPSS is a php-based implementation of IBM SPSS Statistics Standard",
  "keywords": [
    "SPSS",
    "IBM",
    "PSPP",
    "Statistics",
    "DataSet",
    "por",
    "sav",
    "reader",
    "writer",
    "cli",
    "cli-app"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Korniienko Vladyslav",
      "email": "vk.tiamo@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4.1",
    "ext-bcmath": "*",
    "ext-mbstring": "*",
    "ext-zlib": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.34",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.2",
    "rector/rector": "^2.5"
  },
  "autoload": {
    "psr-4": {
      "SPSS\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SPSS\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    },
    "audit": {
      "abandoned": "fail"
    },
    "platform": {
      "php": "8.4.1"
    },
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "scripts": {
    "fix": [
      "rector process",
      "php-cs-fixer fix --verbose"
    ],
    "hooks:install": "git config core.hooksPath .githooks",
    "post-install-cmd": "@hooks:install",
    "post-update-cmd": "@hooks:install",
    "qa": [
      "@test:composer",
      "@test:syntax",
      "@test:style",
      "@test:rector",
      "@test:types",
      "@test:unit"
    ],
    "qa:release": [
      "@qa",
      "@test:coverage",
      "@test:coverage:branch",
      "@test:mutation",
      "@test:interop"
    ],
    "test:composer": [
      "@composer validate --strict",
      "@composer audit --locked"
    ],
    "test:coverage": [
      "@php tools/prepare-qa-directories.php",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-clover build/coverage/clover.xml",
      "@php tools/check-coverage.php line build/coverage/clover.xml 85"
    ],
    "test:coverage:branch": "@php tools/run-branch-coverage.php",
    "test:interop": "@php tools/interop/haven-roundtrip.php",
    "test:mutation": [
      "Composer\\Config::disableProcessTimeout",
      "@php -d xdebug.mode=coverage vendor/bin/infection --configuration=infection.json5.dist --only-covering-test-cases --no-progress --no-interaction"
    ],
    "test:rector": "rector process --dry-run",
    "test:style": "php-cs-fixer check --diff --verbose",
    "test:syntax": "parallel-lint --exclude vendor .php-cs-fixer.dist.php rector.php src tests examples tools",
    "test:types": "phpstan analyse --no-progress --memory-limit=1G",
    "test:unit": "phpunit --no-coverage",
    "test": "@qa"
  }
}
